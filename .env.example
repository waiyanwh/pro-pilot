# Copy to .env and replace every placeholder locally. Never commit .env.
PRO_PILOT_SLACK_BOT_TOKEN=xoxb-your-workspace-bot-token
PRO_PILOT_SLACK_APP_TOKEN=xapp-your-workspace-app-token
PRO_PILOT_SPOKE_TOKEN=replace-with-a-random-local-spoke-token
PRO_PILOT_SPOKE_TOKENS_JSON={"demo-cluster":["sha256:replace-with-the-sha256-hex-of-the-spoke-token"]}
PRO_PILOT_LLM_API_KEY=replace-with-your-model-api-key
# Optional: openai = configured gateway, fake = fully offline, bedrock = AWS Converse.
# PRO_PILOT_LLM_MODE=openai
# Optional nested overrides; public endpoint and model values only.
# PRO_PILOT_LLM__BASE_URL=https://llm.example.com/v1
# PRO_PILOT_LLM__MODEL_ID=your-model-id
# Optional when running from a different checkout directory.
# PRO_PILOT_FIXTURE_ROOT=/absolute/path/to/pro-pilot/tests/fixtures/clusters/demo-cluster
# Optional local EKS settings use config/spoke.eks.example.yaml; never place AWS credentials here.
# PRO_PILOT_KUBERNETES__CONTEXT=pro-pilot-staging-ro
# PRO_PILOT_AWS__PROFILE=pro-pilot-staging-ro
